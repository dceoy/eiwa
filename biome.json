{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "worker/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "*.tsx",
      "*.json",
      "*.jsonc",
      "!**/*.md",
      "!**/*.mdx",
      "!!**/*.yaml",
      "!!**/*.yml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "useExportsLast": "off",
        "noExcessiveLinesPerFile": "off",
        "noDefaultExport": "off"
      }
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          },
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    },
    {
      "includes": [
        "playwright.config.ts",
        "vitest.config.ts",
        "vite.config.ts",
        "scripts/**",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["playwright.config.ts", "tests/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off",
            "noConditionalExpect": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
