{
  "name": "eiwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first English-Japanese / Japanese-English dictionary web app with browser-side WebLLM translation.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=11"
  },
  "scripts": {
    "predev": "pnpm run dict:build",
    "dev": "vite",
    "build": "pnpm run dict:build && pnpm run dict:validate && tsc --noEmit -p tsconfig.app.json && vite build && tsx scripts/check-asset-limits.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && oxfmt --write '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dict:build": "tsx scripts/build-dict-shards.ts",
    "dict:validate": "tsx scripts/validate-dict.ts",
    "deploy:temporary": "wrangler deploy --temporary",
    "smoke:url": "tsx scripts/smoke-url.ts",
    "audit": "pnpm audit --prod",
    "format:check": "biome format . && oxfmt --check '**/*.{md,mdx}' --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261015.1",
    "@mlc-ai/web-llm": "0.2.84",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.1",
    "oxfmt": "0.73.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@11.8.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4",
      "onFail": "download"
    }
  }
}
